# Supabase — auth + database for the planner workspace. Required to sign in and
# persist weddings. (Publishable key is safe to expose; RLS protects the data.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. "Start from a vision board" works WITHOUT a key (a free colour-match
# demo runs). Add a key for full Claude AI board reading (semantic understanding
# of the board's style/elements). Copy this file to .env.local, then restart.
ANTHROPIC_API_KEY=

# Optional: drop in an image-model API key to swap the illustrative preview
# for a real AI render. If unset, the app uses the built-in styled preview.
IMAGE_MODEL_API_KEY=
IMAGE_MODEL_PROVIDER=
